# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# VS Code / IDEs
.vscode/
.idea/

# Virtual Environments
.venv/
.venv-seg
.venv-seg.nosync/
env/
.env
venv/

# Data and Models
# DO NOT COMMIT massive raw datasets, but model weights/checkpoints ARE tracked
# regardless of size if they are part of the CPE end product (see docs/yolo_training.md)
data/
/data
data.nosync/

# Logs and outputs
logs/
evaluation/logs/
*.log

# Temp files
.DS_Store
Thumbs.db

# Randoms
Roadmap.md

# Training artifacts generated by Ultralytics (visual/log artifacts only —
# weight/export files under weights/ and exports/ are tracked, see above)
training/runs/**/*.png
training/runs/**/*.jpg
training/runs/**/*.jpeg
training/runs/**/*.cache

# Secrets only — the Roboflow source manifest itself is small and crucial for
# reproducing the dataset (e.g. after losing local-only data), so it IS tracked.
.env*
!.env.example

# Keep compact benchmark reports, ignore heavy visual previews
!evaluation/benchmarks/**/hazard_eval_*.csv
!evaluation/benchmarks/**/hazard_eval_*.json
!evaluation/benchmarks/**/hazard_eval_*.md
evaluation/benchmarks/**/prediction_previews/
evaluation/benchmarks/**/*.png
# paper figures F2-F6 are shared (F6 needs the segmentation model and SANPO downloads to rebuild)
!evaluation/benchmarks/figures/f[2-6]_*.png
evaluation/benchmarks/**/*.jpg

# iOS timing app: generated by ios/CPETiming/prepare_bundle.py and xcodegen
ios/CPETiming/BenchData/
ios/CPETiming/Models/
ios/CPETiming/*.xcodeproj/
ios/CPETiming/build/
