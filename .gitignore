# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# VS Code / IDEs
.vscode/
.idea/

# Virtual Environments
.venv/
env/
.env
venv/

# Data and Models
# DO NOT COMMIT massive datasets or model weights to git
data/
models/**/*.pt
models/**/*.onnx
models/**/*.gguf
models/**/*.bin

# Logs and outputs
logs/
evaluation/logs/
*.log

# Temp files
.DS_Store
Thumbs.db

# Randoms
Roadmap.md

# Training artifacts generated by Ultralytics
training/runs/**/weights/*.pt
training/runs/**/*.png
training/runs/**/*.jpg
training/runs/**/*.jpeg
training/runs/**/*.onnx
training/runs/**/*.engine
training/runs/**/*.torchscript
training/runs/**/*.cache

# Local Roboflow/source manifests and secrets
training/configs/roboflow_universe_sources.json
.env*
!.env.example

# Keep compact benchmark reports, ignore heavy visual previews
!evaluation/benchmarks/**/hazard_eval_*.csv
!evaluation/benchmarks/**/hazard_eval_*.json
!evaluation/benchmarks/**/hazard_eval_*.md
evaluation/benchmarks/**/prediction_previews/
evaluation/benchmarks/**/*.png
evaluation/benchmarks/**/*.jpg
